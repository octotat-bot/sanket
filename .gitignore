.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
ml/.cache/
ml/.pytest_cache/
ml/.mypy_cache/
ml/.ruff_cache/

# Dataset files never go in git (videos, keypoints, downloads)
data/raw/
data/keypoints/
*.zip
*.MOV
*.mov
*.MP4
*.mp4
*.npz

# Experiment outputs
runs/
checkpoints/
*.onnx
!web/public/models/**/*.onnx

# Local env
.env*
.claude/settings.local.json

# Kaggle credentials. The real location is ~/.kaggle/ (outside the repo); these patterns
# stop a copied token from ever being committed.
kaggle.json
access_token
.kaggle/
# Per-video frame cache for ADR 005 boundary/signer checks: local only, deleted after review
ml/.cache/frames/

# Long-running job logs (extraction etc.)
logs/

# Separate training environment (keeps torch out of the extraction env)
ml/.venv-train/

# Phase 6 participant data: never committed
data/realworld/
sanket-rec-*.json
